# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (Neon PostgreSQL) ──────────────────────────────────────
# Pooled connection (PgBouncer) used by the app at runtime:
DATABASE_URL="postgresql://neondb_owner:npg_cHXy4ILjJ5RQ@ep-icy-rain-aq18ve51.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct connection used by Prisma Migrate (no pgbouncer):
DIRECT_URL=postgresql://neondb_owner:npg_cHXy4ILjJ5RQ@ep-icy-rain-aq18ve51.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="123456789:ABCDEF_your_bot_token_here"
TELEGRAM_BOT_USERNAME="your_shop_bot"

# ── Admin access ────────────────────────────────────────────────────
# Comma-separated master Telegram IDs that get full admin access:
ADMIN_TELEGRAM_IDS="100000001"
# Optional machine-to-machine admin token (for scripts/dashboards):
ADMIN_API_TOKEN="generate-a-long-random-string"

# ── Web / CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins (your deployed web app), or * in dev:
CORS_ORIGINS="https://your-app.vercel.app"
CONTACT_ADMIN_URL="https://t.me/your_support_username"

# ── Security ────────────────────────────────────────────────────────
# initData freshness window in seconds (replay protection):
INITDATA_MAX_AGE_SECONDS=86400
# DEV ONLY: allow x-dev-telegram-id header without initData. NEVER in prod.
ALLOW_INSECURE_AUTH=false

# ── Scheduler ───────────────────────────────────────────────────────
# Cron cadence for the notification scheduler tick (every minute default):
NOTIFY_CRON="* * * * *"

# Seed helper (optional):
SEED_ADMIN_ID="100000001"
