# Base URL of the deployed API (no trailing slash).
VITE_API_BASE_URL="http://localhost:4000/api"

# Telegram support contact (deep link opened from "Contact admin").
VITE_CONTACT_ADMIN_URL="https://t.me/your_support_username"

# DEV ONLY: simulate a Telegram user when running in a normal browser.
# Must match a whitelisted Telegram ID and the API must run with
# ALLOW_INSECURE_AUTH=true. Leave empty in production builds.
VITE_DEV_TELEGRAM_ID=""
